{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "{backend/tests/**,backend/**/test_*.py,docs/**,e2e/**,scripts/**,coverage/**,playwright-report/**,test-results/**}",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "daemons": {
    "line-worker": {
      "root": "backend",
      "entrypoint": "Dockerfile.line-worker",
      "command": [
        "python",
        "-m",
        "backend.workers.line",
        "--health-port",
        "8080"
      ],
      "instances": {
        "sin1": 0
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "terminationGracePeriodSeconds": 40,
      "livenessProbe": {
        "httpGet": {
          "path": "/health",
          "port": 8080
        },
        "initialDelaySeconds": 30,
        "periodSeconds": 30,
        "timeoutSeconds": 2,
        "failureThreshold": 3
      }
    }
  }
}
