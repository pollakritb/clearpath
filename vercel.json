{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "excludeFiles": "{backend/tests/**,backend/**/test_*.py,docs/**,e2e/**,scripts/**,coverage/**,playwright-report/**,test-results/**}",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }]
}
