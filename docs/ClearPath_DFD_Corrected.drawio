  <diagram id="clearpath-data-dictionary" name="3. Data Dictionary">
    <mxGraphModel dx="2100" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="dd0" />
        <mxCell id="dd1" parent="dd0" />
        <mxCell id="dd-title" value="Data Dictionary — แฟ้มข้อมูลหลักของ ClearPath" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#123047;" vertex="1" parent="dd1">
          <mxGeometry x="370" y="20" width="1300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dd-note" value="หมายเหตุ: รูปภาพและพิกัดจริงเป็นข้อมูลส่วนตัว • Public API ห้ามเปิด image_path, exact GPS และ OCR raw text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="420" y="75" width="1200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dd-d1" value="&lt;b&gt;D1 — Official Stations &amp;amp; PM2.5 Readings&lt;/b&gt;&lt;br&gt;&lt;hr&gt;station_id (PK), name_th, name_en, province, lat, lon, pm25, aqi, level, color, recorded_at, updated_at, data_status, eligible_for_surface" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="60" y="170" width="610" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dd-d2" value="&lt;b&gt;D2 — Weather &amp;amp; Fire Hotspot Snapshots&lt;/b&gt;&lt;br&gt;&lt;hr&gt;source, station_id (FK), lat, lon, temperature, humidity, wind_speed, wind_deg, rain_mm, frp, brightness, confidence, satellite, acquired_at, recorded_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="730" y="170" width="610" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dd-d3" value="&lt;b&gt;D3 — Profiles / User Reputation&lt;/b&gt;&lt;br&gt;&lt;hr&gt;user_id (PK/FK auth), display_name, role, reputation_score, approved_reports, helpful_reviews, weekly_points (derived), created_at, updated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="1400" y="170" width="610" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dd-d4" value="&lt;b&gt;D4 — Capture Sessions &amp;amp; Report Drafts&lt;/b&gt;&lt;br&gt;&lt;hr&gt;session_id (PK), user_id (FK), issued_at, expires_at, consumed_at&lt;br&gt;draft_id (PK), session_id (FK), exact_lat, exact_lon, gps_accuracy_m, image_path, image_sha256, perceptual_hash, ocr_pm25, ocr_confidence, clock_warning, submitted_at, expires_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="60" y="360" width="950" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dd-d5" value="&lt;b&gt;D5 — Private Report Evidence / Image Store&lt;/b&gt;&lt;br&gt;&lt;hr&gt;image_id (PK), report_id (FK), user_id (FK), capture_session_id (FK), storage_path, content_type, file_size_bytes, image_width, image_height, captured_at, server_received_at, exact_latitude, exact_longitude, gps_accuracy_m, image_sha256, perceptual_hash, burst_hashes, ocr_raw_text, ocr_pm25, ocr_confidence, device_detected, display_clear, duplicate_of_report_id, screen_recapture_suspected, retention_until, audit_hold, purged_at, created_at&lt;br&gt;&lt;b&gt;Storage:&lt;/b&gt; private bucket; DB เก็บ path ไม่เก็บ Base64" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="1060" y="360" width="950" height="250" as="geometry" />
        </mxCell>
        <mxCell id="dd-d6" value="&lt;b&gt;D6 — Community Reports&lt;/b&gt;&lt;br&gt;&lt;hr&gt;report_id (PK), user_id (FK), user_claimed_pm25, ocr_pm25, admin_verified_pm25, public_pm25, exact_lat/private, exact_lon/private, public_lat, public_lon, gps_accuracy_m, captured_at, device_model, device_calibrated, calibrated_at, measurement_environment, measurement_stable, near_emission_source, averaging_period, measurement_duration_seconds, status {pending|approved|rejected}, rejection_reason_code, moderation_checks, base_trust_score, trust_score, rating_count, rating_average, data_role {supplementary|gap_fill}, policy_version, created_at, moderated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="60" y="650" width="950" height="260" as="geometry" />
        </mxCell>
        <mxCell id="dd-d7" value="&lt;b&gt;D7 — Ratings / Trust / Reputation Events&lt;/b&gt;&lt;br&gt;&lt;hr&gt;rating_id (PK), report_id (FK), reviewer_id (FK), rating_stars {1..5}, reason_code, note, reviewer_lat/private, reviewer_lon/private, reviewer_distance_km, gps_accuracy_m, reviewer_weight, rating_direction, rewarded_at, created_at&lt;br&gt;event_id (PK), user_id, report_id, points, reason, idempotency_key, created_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="1060" y="650" width="950" height="220" as="geometry" />
        </mxCell>
        <mxCell id="dd-d8" value="&lt;b&gt;D8 — Announcements &amp;amp; Activities&lt;/b&gt;&lt;br&gt;&lt;hr&gt;announcement_id (PK), title, body, kind {news|alert|community}, area, image_path, status {draft|published|archived|expired}, published, published_at, expires_at, created_by, updated_by, created_at, updated_at&lt;br&gt;activity_id (PK), title, description, reward_points, starts_at, ends_at, active" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="60" y="950" width="950" height="210" as="geometry" />
        </mxCell>
        <mxCell id="dd-d9" value="&lt;b&gt;D9 — Forecast Models &amp;amp; Predictions&lt;/b&gt;&lt;br&gt;&lt;hr&gt;model_id (PK), station_id, horizon_hours, algorithm, version, artifact_path, trained_at, train_rows, validation_rmse, baseline_rmse, eligible, active, activation_reason&lt;br&gt;prediction_id, station_id, forecast_at, pm25, lower_bound, upper_bound, model_version, data_quality, generated_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="1060" y="950" width="950" height="210" as="geometry" />
        </mxCell>
        <mxCell id="dd-d10" value="&lt;b&gt;D10 — Notifications / Subscriptions / Outbox&lt;/b&gt;&lt;br&gt;&lt;hr&gt;notification_id (PK), user_id (FK), event_type, title, body, url, entity_type, entity_id, payload, deduplication_key, read_at, created_at&lt;br&gt;subscription_id, user_id, endpoint, p256dh, auth_secret, user_agent, active, updated_at&lt;br&gt;outbox_id, notification_id, event_key, status, attempts, next_attempt_at, last_error, processed_at" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="60" y="1200" width="950" height="220" as="geometry" />
        </mxCell>
        <mxCell id="dd-d11" value="&lt;b&gt;D11 — Audit Logs &amp;amp; Sync Runs&lt;/b&gt;&lt;br&gt;&lt;hr&gt;audit_id (PK), actor_id, action, entity_type, entity_id, details, created_at&lt;br&gt;sync_run_id (PK), source, status, started_at, completed_at, fetched_count, station_count, reading_count, source_recorded_at, error_message" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="1060" y="1200" width="950" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dd-rules" value="&lt;b&gt;กฎสำคัญของข้อมูล&lt;/b&gt;&lt;br&gt;1) รายงานใหม่เป็น pending และ public_pm25 ต้องเป็น null&lt;br&gt;2) Admin เท่านั้นที่กำหนด admin_verified_pm25 และเปลี่ยนเป็น approved&lt;br&gt;3) OCR เป็น advisory ไม่อนุมัติอัตโนมัติ&lt;br&gt;4) Public coordinates ใช้ stable obfuscation 120–250 ม.&lt;br&gt;5) ผู้ให้คะแนนต้องอยู่ภายใน 3 กม., GPS ≤200 ม., รายงานอายุ ≤3 ชม. และห้ามให้คะแนนตนเอง&lt;br&gt;6) Hotspot ต้องเรียกว่า satellite hotspot ไม่ใช่เหตุไฟไหม้ยืนยันแล้ว" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="dd1">
          <mxGeometry x="300" y="1470" width="1450" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
