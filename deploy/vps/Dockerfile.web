FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 CLEARPATH_STANDALONE=true
COPY package.json package-lock.json ./
RUN npm ci
COPY next.config.ts tsconfig.json ./
COPY app ./app
COPY frontend ./frontend
COPY public ./public
COPY vendor ./vendor
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_LOCAL_DEMO_MODE=false
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN groupadd --gid 10001 clearpath && useradd --uid 10001 --gid clearpath --no-create-home clearpath
COPY --from=builder --chown=clearpath:clearpath /app/.next/standalone ./
COPY --from=builder --chown=clearpath:clearpath /app/.next/static ./.next/static
COPY --from=builder --chown=clearpath:clearpath /app/public ./public
USER clearpath
EXPOSE 3000
CMD ["node", "server.js"]
