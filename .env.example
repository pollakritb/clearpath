# ───────────────────────────────────────────────────────────
# ClearPath — environment variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)
# ───────────────────────────────────────────────────────────

# ── External APIs ──────────────────────────────────────────
GEOAPIFY_API_KEY=

# Open-Meteo Air Quality/CAMS ใช้ได้โดยไม่ต้องมี key; จำกัด batch ไม่เกิน 50 สถานี
OPENMETEO_AIR_ENABLED=true
# Serve raw Open-Meteo/CAMS values from public forecast endpoints.
EXTERNAL_FORECAST_ENABLED=true
FORECAST_PROVIDER_MAX_BATCH_SIZE=50
FORECAST_PROVIDER_SNAPSHOT_RETENTION_DAYS=7
FORECAST_PROVIDER_RUN_RETENTION_DAYS=30
# NASA FIRMS — https://firms.modaps.eosdis.nasa.gov/api/ (สมัครรอ 1-2 วัน)
FIRMS_MAP_KEY=

# air4thai ไม่ต้องใช้ key (เปลี่ยน endpoint ได้ถ้าจำเป็น)
AIR4THAI_URL=http://air4thai.pcd.go.th/services/getNewAQI_JSON.php

# OpenAI Responses API — อ่านเฉพาะตัวเลข PM2.5 จากภาพ
# ถ้าไม่ตั้งค่า รายงานจะไม่ถูกเผยแพร่และระบบจะให้ผู้ใช้ถ่ายใหม่
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-5.4-mini

# ── Supabase ───────────────────────────────────────────────
# ใช้ service_role key ฝั่ง server เท่านั้น (มีสิทธิ์เขียน) — ห้ามใส่ฝั่ง browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REPORT_IMAGE_BUCKET=report-images

# ── Runtime / observability ────────────────────────────────
APP_ENVIRONMENT=development
RELEASE_SHA=local
LOG_LEVEL=INFO
# comma-separated; production ใส่เฉพาะ origin จริง เช่น https://clearpath.example
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ค่า public สำหรับ Supabase Email OTP ใน Next.js (anon key ไม่ใช่ service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ลงนาม camera session อายุ 5 นาที (ใช้ random secret ยาวอย่างน้อย 32 ตัวอักษร)
CAPTURE_SESSION_SECRET=
CAPTURE_SESSION_TTL_SECONDS=300

# ── Cron ───────────────────────────────────────────────────
# secret สำหรับยืนยัน GitHub Actions scheduler ที่เรียก /api/cron/*
# ตั้งค่าเดียวกันใน Vercel Environment Variables และ GitHub Actions Secret
CRON_SECRET=
# Dedicated bearer token for Supabase Cron; keep different from CRON_SECRET.
SUPABASE_CRON_SECRET=

# Scheduled air-quality / hotspot alerts (legacy flag name).
PUSH_ENABLED=false

# LINE Messaging API (server only). Create a LINE Official Account + Messaging API channel.
LINE_MESSAGING_ENABLED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OFFICIAL_ACCOUNT_URL=
APP_PUBLIC_URL=https://clearpath-gray.vercel.app

# ── Dev only ───────────────────────────────────────────────
# origin ของ FastAPI ตอน dev (Next จะ proxy ไปที่นี่)
BACKEND_ORIGIN=http://127.0.0.1:8000

# ใช้เฉพาะตอนพัฒนาเมื่อยังไม่มี Supabase: in-memory data หายเมื่อปิด Backend
LOCAL_DEMO_MODE=false
NEXT_PUBLIC_LOCAL_DEMO_MODE=false

# Community measurement requests: keep disabled until migration and minute cron are installed.
MEASUREMENT_REQUESTS_ENABLED=false

# Stored CAMS collectors: keep off until their current schema and cron are ready.
CAMS_SNAPSHOT_COLLECTION_ENABLED=false
CAMS_GRID_COLLECTION_ENABLED=false
CAMS_SNAPSHOT_EXPECTED_SUPABASE_REF=

# Optional staging-only CAMS validation; never changes public forecasts.
FORECAST_VALIDATION_ENABLED=false
FORECAST_VALIDATION_PUBLIC_METRICS_ENABLED=false
FORECAST_VALIDATION_COHORT_IDS=
COMMUNITY_XP_ENABLED=false
# Historical evidence/settlement compatibility; do not use to launch an old XP/Trust policy.
COMMUNITY_V2_ENABLED=false
# Local demo launch only. Production launch is owned by the DB release pointer.
COMMUNITY_V2_DEMO_LAUNCH=2026-11-05T00:00:00+07:00

# Activate only after the registered measurement migration is installed.
# The database rollout switch must also be enabled (see docs/features/registered-measurement-areas.md).
MEASUREMENT_REGISTERED_LOCATIONS_ENABLED=false

# Structured owner activity export and erasure requests, not automatic deletion.
ACCOUNT_PRIVACY_ENABLED=false

# Scheduled Google News metadata + nationwide FIRMS snapshots.
# Apply both scheduled_external_feeds migrations and deploy the cron route first.
EXTERNAL_FEED_STORAGE_ENABLED=false
GOOGLE_NEWS_ENABLED=true
GOOGLE_NEWS_QUERY="(PM2.5 OR ฝุ่น OR คุณภาพอากาศ) ประเทศไทย when:7d"

# Community opinion: separate from independent reporter audits. Database release gates also apply.
COMMUNITY_TRUST_COLLECTION_ENABLED=false
COMMUNITY_TRUST_PUBLIC_ENABLED=false

# XP contribution-v3 is independent of Trust and publication. Database release is required.
CONTRIBUTION_V3_ENABLED=false
CONTRIBUTION_V3_DEMO_START=2026-12-01T00:00:00+07:00

# Enable only after the LINE nearest-pin migration is applied and worker is ready.
# Run: .venv/bin/python -m scripts.line_worker
LINE_DURABLE_DELIVERY_ENABLED=false
LINE_REQUESTS_PER_SECOND=5
# Required positive cap for durable delivery. Keep below your OA monthly allowance.
LINE_MONTHLY_MESSAGE_CAP=0
# Evaluate without creating notices or changing episodes during rollout.
LINE_ALERT_SHADOW_MODE=false
# Optional comma-separated internal profile IDs for initial opt-in canary.
LINE_ALERT_CANARY_USER_IDS=

# Enable only after unified_cams_grid_reads migration and local/rollout checks.
CAMS_GRID_FORECAST_ENABLED=false
