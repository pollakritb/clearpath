# ───────────────────────────────────────────────────────────
# ClearPath — environment variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (อย่า commit .env.local)
# ───────────────────────────────────────────────────────────

# ── External APIs ──────────────────────────────────────────
# OpenWeatherMap — https://openweathermap.org/api (ฟรี 1,000 calls/วัน)
OPENWEATHER_API_KEY=
OPENWEATHER_AIR_ENABLED=true

# Open-Meteo Air Quality/CAMS ใช้ได้โดยไม่ต้องมี key; จำกัด batch ไม่เกิน 50 สถานี
OPENMETEO_AIR_ENABLED=true
FORECAST_PROVIDER_MAX_BATCH_SIZE=50

# Shadow-only kill switch; ห้ามเปิดจน rolling backtest/field validation ผ่าน
COMMUNITY_FORECAST_SHADOW_ENABLED=false
FORECAST_STATION_MIN_HISTORY_POINTS=24
FORECAST_STATION_MAX_AGE_MINUTES=90

# NASA FIRMS — https://firms.modaps.eosdis.nasa.gov/api/ (สมัครรอ 1-2 วัน)
FIRMS_MAP_KEY=

# air4thai ไม่ต้องใช้ key (เปลี่ยน endpoint ได้ถ้าจำเป็น)
AIR4THAI_URL=http://air4thai.pcd.go.th/services/getNewAQI_JSON.php

# OpenAI Responses API — OCR ภาพหน้าจอเครื่องวัด PM2.5
# ถ้าไม่ตั้งค่า ระบบยังรับภาพได้ตามปกติ และ Admin จะอ่าน/กรอกค่าจากภาพด้วยตนเอง
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-5.4-mini

# ── Supabase ───────────────────────────────────────────────
# ใช้ service_role key ฝั่ง server เท่านั้น (มีสิทธิ์เขียน) — ห้ามใส่ฝั่ง browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REPORT_IMAGE_BUCKET=report-images

# ── Runtime / observability ────────────────────────────────
APP_ENVIRONMENT=development
RELEASE_SHA=local
LOG_LEVEL=INFO
# comma-separated; production ใส่เฉพาะ origin จริง เช่น https://clearpath.example
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
READINESS_MAX_STATION_AGE_MINUTES=90

# ค่า public สำหรับ Supabase Email OTP ใน Next.js (anon key ไม่ใช่ service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ลงนาม camera session อายุ 5 นาที (ใช้ random secret ยาวอย่างน้อย 32 ตัวอักษร)
CAPTURE_SESSION_SECRET=
CAPTURE_SESSION_TTL_SECONDS=300

# อนุมัติอัตโนมัติเฉพาะ OCR/หลักฐานที่ผ่านเกณฑ์เข้ม; เคสไม่แน่ใจยังเข้าคิว Admin
AUTOMATIC_REVIEW_ENABLED=true
AUTOMATIC_REVIEW_MIN_CONFIDENCE=0.92
AUTOMATIC_REVIEW_MAX_GPS_ACCURACY_M=100

# ── Cron ───────────────────────────────────────────────────
# secret สำหรับยืนยัน GitHub Actions scheduler ที่เรียก /api/cron/*
# ตั้งค่าเดียวกันใน Vercel Environment Variables และ GitHub Actions Secret
CRON_SECRET=

# ── Web Push ──────────────────────────────────────────────
# สร้าง VAPID key pair แล้วเก็บ private key ฝั่ง server เท่านั้น
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# LINE Messaging API (server only). Create a LINE Official Account + Messaging API channel.
LINE_MESSAGING_ENABLED=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OFFICIAL_ACCOUNT_URL=

# เปิดได้เมื่อ artifact ใน backend/model_artifacts ผ่าน activation gate เท่านั้น
ML_FORECAST_ENABLED=false
ML_FORECAST_SHADOW_ENABLED=false
# Canary ใช้ deterministic station bucket; 0 หมายถึงไม่เสิร์ฟ canary
ML_FORECAST_CANARY_PERCENTAGE=0
ML_FORECAST_CANARY_STATION_ALLOWLIST=
FORECAST_PREDICTION_RETENTION_DAYS=400

# ── Dev only ───────────────────────────────────────────────
# origin ของ FastAPI ตอน dev (Next จะ proxy ไปที่นี่)
BACKEND_ORIGIN=http://127.0.0.1:8000

# ใช้เฉพาะตอนพัฒนาเมื่อยังไม่มี Supabase: in-memory data หายเมื่อปิด Backend
LOCAL_DEMO_MODE=false
